generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  USER
  ADMIN
}

enum SeriesStatus {
  ONGOING
  COMPLETED
  HIATUS
}

enum UnlockType {
  FREE
  AD
  PREMIUM
}

enum ReadingStatus {
  READING
  PLAN_TO_READ
  COMPLETED
  DROPPED
}

enum SubscriptionPlan {
  FREE
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  LEMON_SQUEEZY
  PADDLE
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TimePeriod {
  DAILY
  WEEKLY
  MONTHLY
}

// Core Models
model User {
  id       String @id @default(cuid())
  username String @unique
  email    String @unique
  password String

  avatar      String?
  displayName String?
  bio         String? @db.Text

  readingStreak Int @default(0)

  role        UserRole @default(USER)
  suspendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookmarks      Bookmark[]
  history        ReadingHistory[]
  comments       Comment[]
  ratings        Rating[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  chapterUnlocks ChapterUnlock[]
  seriesStatuses UserSeriesStatus[]
  notifications  Notification[]
  reports        Report[] @relation("ReporterReports")
  moderatedReports Report[] @relation("ModeratorReports")
  moderationActions ModerationAction[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([createdAt])
}

model Series {
  id String @id @default(cuid())

  title String
  slug  String @unique

  description String @db.Text

  coverImage  String
  bannerImage String?

  author String?
  artist String?

  status SeriesStatus @default(ONGOING)

  // Performance fields (pre-computed for queries)
  views         Int    @default(0)
  averageRating Float  @default(0)
  totalRatings  Int    @default(0)
  totalChapters Int    @default(0)
  readersCount  Int    @default(0)

  // UI flags
  verified  Boolean @default(false)
  isFeatured Boolean @default(false)
  isNew     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chapters      Chapter[]
  genres        SeriesGenre[]
  tags          SeriesTag[]
  bookmarks     Bookmark[]
  ratings       Rating[]
  stats         SeriesStats[]
  collections   CollectionSeries[]
  editorPicks   EditorPick[]
  userStatuses  UserSeriesStatus[]

  @@index([status])
  @@index([isFeatured])
  @@index([isNew])
  @@index([createdAt])
  @@index([averageRating])
  @@index([views])
  @@index([slug])
}

model Chapter {
  id String @id @default(cuid())

  seriesId String

  chapterNumber Decimal @db.Decimal(5, 2)

  title String?
  slug  String

  views Int @default(0)

  unlockType UnlockType @default(FREE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  series           Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  pages            ChapterPage[]
  comments         Comment[]
  readingHistories ReadingHistory[]
  chapterUnlocks   ChapterUnlock[]

  @@unique([seriesId, chapterNumber])
  @@index([seriesId])
  @@index([updatedAt])
}

model ChapterPage {
  id String @id @default(cuid())

  chapterId String

  pageNumber Int

  imageUrl String

  // Relations
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, pageNumber])
}

model Genre {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  // UI fields
  icon  String?
  color String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  series SeriesGenre[]
  stats  GenreStats[]
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  series SeriesTag[]
}

// Junction Tables
model SeriesGenre {
  seriesId String
  genreId  String

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
}

model SeriesTag {
  seriesId String
  tagId    String

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([seriesId, tagId])
}

model UserSeriesStatus {
  userId   String
  seriesId String

  status ReadingStatus @default(READING)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@id([userId, seriesId])
}

// User Activity Models
model Bookmark {
  id String @id @default(cuid())

  userId   String
  seriesId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, seriesId])
  @@index([userId])
  @@index([seriesId])
  @@index([createdAt])
}

model ReadingHistory {
  id String @id @default(cuid())

  userId    String
  chapterId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model Rating {
  id String @id @default(cuid())

  userId   String
  seriesId String

  rating Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, seriesId])
  @@index([seriesId])
  @@index([rating])
  @@index([createdAt])
}

model Comment {
  id String @id @default(cuid())

  content String @db.Text

  userId    String
  chapterId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id String @id @default(cuid())

  userId String
  type   NotificationType
  title  String
  body   String @db.Text

  isRead Boolean @default(false)

  // Optional: Link to related entity
  chapterId String?
  seriesId  String?
  commentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

enum NotificationType {
  NEW_CHAPTER
  COMMENT_REPLY
  SYSTEM_ANNOUNCEMENT
  PREMIUM_ANNOUNCEMENT
}

// Analytics Models
model SeriesStats {
  id        String @id @default(cuid())
  seriesId  String

  date      DateTime
  period    TimePeriod

  views     Int    @default(0)
  readers   Int    @default(0)
  bookmarks Int    @default(0)
  ratings   Int    @default(0)

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, date, period])
  @@index([seriesId])
  @@index([date])
  @@index([period])
}

model GenreStats {
  id     String @id @default(cuid())
  genreId String

  date        DateTime
  period      TimePeriod

  readers     Int    @default(0)
  seriesCount Int    @default(0)

  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([genreId, date, period])
  @@index([genreId])
  @@index([date])
}

// Curation Models
model Collection {
  id        String @id @default(cuid())
  title     String
  slug      String @unique
  image     String
  seriesCount Int @default(0)

  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series CollectionSeries[]
}

model CollectionSeries {
  collectionId String
  seriesId     String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  series     Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([collectionId, seriesId])
}

model EditorPick {
  id        String @id @default(cuid())
  seriesId  String

  featuredAt DateTime @default(now())

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId])
  @@index([featuredAt])
}

// Monetization Models
model SubscriptionPlanDetails {
  id             String @id @default(cuid())
  plan           SubscriptionPlan @unique
  name           String
  description    String @db.Text
  price          Decimal @db.Decimal(10, 2)
  currency       String @default("USD")
  features       Json
  isPopular      Boolean @default(false)
  stripePriceId  String?
  stripeProductId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id                     String @id @default(cuid())
  userId                 String

  plan                   SubscriptionPlan
  status                 SubscriptionStatus @default(ACTIVE)
  provider               PaymentProvider @default(STRIPE)
  providerSubscriptionId String?
  startsAt               DateTime
  expiresAt              DateTime
  autoRenew              Boolean @default(true)
  cancelledAt            DateTime?
  lastPaymentAt          DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices               Invoice[]

  @@index([userId])
  @@index([expiresAt])
  @@index([status])
  @@index([providerSubscriptionId])
}

model Invoice {
  id              String @id @default(cuid())
  userId          String
  subscriptionId  String

  amount          Decimal @db.Decimal(10, 2)
  currency        String @default("USD")
  status          InvoiceStatus @default(PENDING)
  invoiceUrl      String?
  providerInvoiceId String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([providerInvoiceId])
}

model ChapterUnlock {
  id        String @id @default(cuid())
  userId    String
  chapterId String

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}

// Moderation Models
model Report {
  id          String @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      String
  description String? @db.Text
  status      ReportStatus @default(PENDING)
  moderatorId String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter  User  @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator User? @relation("ModeratorReports", fields: [moderatorId], references: [id])

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

model ModerationAction {
  id          String @id @default(cuid())
  moderatorId String
  actionType  ModerationActionType
  targetType  ModerationTargetType
  targetId    String
  reason      String?
  metadata    String? @db.Text

  createdAt DateTime @default(now())

  moderator User @relation(fields: [moderatorId], references: [id])

  @@index([moderatorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum ReportTargetType {
  COMMENT
  RATING
  USER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  APPROVE
  DELETE
  HIDE
  WARN
  SUSPEND
  BAN
}

enum ModerationTargetType {
  COMMENT
  RATING
  USER
}

// System Settings
model SystemSetting {
  id        String @id @default(cuid())
  key       String @unique
  value     String @db.Text
  category  SettingCategory
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
  @@index([category])
}

enum SettingCategory {
  GENERAL
  HOMEPAGE
  PREMIUM
  COMMUNITY
  STORAGE
  SEO
  EMAIL
  FEATURE_FLAGS
  MAINTENANCE
}
